VITE_APP_TIMEZONE=UTC
VITE_NEXUS_BRAIN_URL=https://emzinexus.com

# Local dev (default): relative /api is proxied to Laravel by Vite (see vite.config.js).
VITE_API_BASE_URL=/api
VITE_DEV_API_TARGET=http://127.0.0.1:8787

# Production build (split domains — edit frontend/.env before npm run build):
# VITE_API_BASE_URL=https://linklyapi.emzinexus.com/api
