VITE_APP_TIMEZONE=UTC

# Local dev: relative /api is proxied to Laravel by Vite (see vite.config.js).
VITE_API_BASE_URL=/api
VITE_DEV_API_TARGET=http://127.0.0.1:8787

# Production (separate API subdomain): copy frontend/.env.production.example to
# frontend/.env.production and set VITE_API_BASE_URL=https://your-api.example.com/api

VITE_NEXUS_BRAIN_URL=https://emzinexus.com
