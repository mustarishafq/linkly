{
  "name": "ShortLink",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "Custom or auto-generated slug for the short URL"
    },
    "destination_url": {
      "type": "string",
      "description": "The target URL to redirect to"
    },
    "title": {
      "type": "string",
      "description": "Friendly name for the link"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for organizing links"
    },
    "campaign_id": {
      "type": "string",
      "description": "Associated campaign ID"
    },
    "facebook_pixel_id": {
      "type": "string",
      "description": "Optional Facebook Pixel ID for tracking"
    },
    "expire_by_date": {
      "type": "string",
      "format": "date-time",
      "description": "Expiry date for the link"
    },
    "expire_by_clicks": {
      "type": "number",
      "description": "Max clicks before expiry"
    },
    "fallback_url": {
      "type": "string",
      "description": "URL to redirect to after expiry"
    },
    "custom_redirect_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Show a custom page before redirecting"
    },
    "custom_redirect_html": {
      "type": "string",
      "description": "Rich text HTML shown on the custom redirect page"
    },
    "custom_redirect_delay": {
      "type": "number",
      "default": 5,
      "description": "Seconds to wait before continuing to the destination"
    },
    "custom_redirect_button_label": {
      "type": "string",
      "description": "Label for the continue button on the custom redirect page"
    },
    "custom_redirect_countdown_text": {
      "type": "string",
      "description": "Countdown line on the custom redirect page. {seconds} is replaced with the time left."
    },
    "custom_redirect_raw_html": {
      "type": "string",
      "description": "Custom HTML rendered on the redirect page"
    },
    "custom_redirect_css": {
      "type": "string",
      "description": "Custom CSS applied on the redirect page"
    },
    "custom_redirect_js": {
      "type": "string",
      "description": "Custom JavaScript that runs on the redirect page"
    },
    "total_clicks": {
      "type": "number",
      "default": 0
    },
    "unique_clicks": {
      "type": "number",
      "default": 0
    },
    "conversions": {
      "type": "number",
      "default": 0
    },
    "is_ab_test": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "paused"
      ],
      "default": "active"
    }
  },
  "required": [
    "slug",
    "destination_url"
  ]
}