{
  "name": "LinkTree",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "integer",
      "description": "User ID who owns this link tree"
    },
    "slug": {
      "type": "string",
      "description": "Public path segment for /t/{slug}"
    },
    "title": {
      "type": "string",
      "description": "Display name shown on the public page"
    },
    "bio": {
      "type": "string",
      "description": "Short supporting text under the title"
    },
    "avatar_url": {
      "type": "string",
      "description": "Optional profile image URL"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "paused"],
      "default": "draft"
    },
    "theme": {
      "type": "object",
      "properties": {
        "background_preset": {
          "type": "string",
          "enum": ["slate", "ocean", "forest", "sunset", "midnight", "sand", "bloom", "aurora", "paper", "ember"],
          "default": "slate"
        },
        "background_image_url": {
          "type": "string",
          "description": "Optional full-bleed background image URL"
        },
        "background_fit": {
          "type": "string",
          "enum": ["cover", "contain", "fill"],
          "default": "cover",
          "description": "How the image fills the page frame"
        },
        "background_position": {
          "type": "string",
          "enum": ["top-left", "top", "top-right", "left", "center", "right", "bottom-left", "bottom", "bottom-right"],
          "default": "center",
          "description": "Focal point of the background image within the frame"
        },
        "background_zoom": {
          "type": "integer",
          "minimum": 100,
          "maximum": 200,
          "default": 100,
          "description": "Zoom percent when fit is cover"
        },
        "overlay_opacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 45,
          "description": "How strongly the selected background preset overlays the image (0 = image only, 100 = full preset)"
        },
        "button_style": {
          "type": "string",
          "enum": ["solid", "outline", "soft", "glass"],
          "default": "solid"
        },
        "button_radius": {
          "type": "string",
          "enum": ["rounded", "pill", "square"],
          "default": "rounded"
        },
        "font_style": {
          "type": "string",
          "enum": ["sans", "display", "mono"],
          "default": "sans"
        },
        "avatar_shape": {
          "type": "string",
          "enum": ["circle", "rounded"],
          "default": "circle"
        },
        "accent_color": {
          "type": "string",
          "default": "#0f766e"
        },
        "show_branding": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "socials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": ["instagram", "x", "tiktok", "youtube", "linkedin", "facebook", "github", "website"]
          },
          "url": { "type": "string" }
        },
        "required": ["platform", "url"]
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["link", "custom", "video", "music", "image", "header", "text", "email", "phone", "whatsapp", "maps", "divider"],
            "default": "link"
          },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "description": { "type": "string" },
          "image_url": { "type": "string" },
          "icon": {
            "type": "string",
            "description": "Lucide icon id for custom blocks"
          },
          "enabled": { "type": "boolean", "default": true },
          "sort_order": { "type": "integer", "default": 0 }
        }
      }
    }
  },
  "required": ["title", "slug"]
}
