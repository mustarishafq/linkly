{
  "name": "linkly",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:api": "cd backend && php artisan serve --host=127.0.0.1 --port=8787",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install && npm install --prefix frontend && cd backend && composer install",
    "migrate": "cd backend && php artisan migrate --force",
    "seed": "cd backend && php artisan db:seed --force",
    "lint": "npm run lint --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
